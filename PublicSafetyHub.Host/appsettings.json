{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "PublicSafetyHub": "Warning"
      }
    }
  },
  "ApplicationLoggingOptions": {
    "FilePath": "Logs/application-.json",
    "RetainedFileCountLimit": 30,
    "FileSizeLimitBytes": 10485760
  },
  "PostgreSqlLoggingOptions": {
    "ConnectionStringName": "DefaultConnection",
    "RetentionDays": 30,
    "BatchSizeLimit": 50,
    "QueueLimit": 10000,
    "PeriodSeconds": 5
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ArmyArticleImportOptions": {
    "FeedUrl": "https://www.mo.gov.cz/rss-acr.xml",
    "BaseUrl": "https://acr.army.cz/",
    "Enabled": true
  },
  "PoliceArticleImportOptions": {
    "BaseUrl": "https://policie.gov.cz/",
    "ListPath": "zpravodajstvi",
    "Enabled": true
  },
  "ArticleImportOptions": {
    "MorningTime": "06:00:00",
    "EveningTime": "19:00:00",
    "TimeZoneId": "Europe/Prague"
  },
  "FirefightersArticleImportOptions": {
    "Enabled": true,
    "ImapHost": "imap.seznam.cz",
    "ImapPort": 993,
    "Username": "",
    "Password": ""
  },
  "OpenAiOptions": {
    "ApiKey": "",
    "EmbeddingModel": "text-embedding-3-small"
  },
  "ArticleEmbeddingOptions": {
    "Enabled": true,
    "IntervalHours": 4,
    "BatchSize": 5
  },
  "AuthOptions": {
    "Issuer": "https://localhost:7102/",
    "Clients": [
      {
        "ClientId": "public-safety-hub",
        "Enabled": false,
        "RedirectUris": [],
        "Scopes": [ "openid", "roles", "offline_access", "public-safety-hub-api" ]
      },
      {
        "ClientId": "public-safety-hub-mobile",
        "Enabled": false,
        "RedirectUris": [],
        "Scopes": [ "openid", "roles", "offline_access", "public-safety-hub-api" ]
      }
    ],
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SigningPrivateKey": "",
    "EncryptionKey": ""
  },
  "AUTOMAPPER_LICENSE_KEY": ""
}
